# Telegram
BOT_TOKEN=your_bot_token_here

# Google Gemini → https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy...
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
GEMINI_MAX_RETRIES=5
GEMINI_RETRY_DELAY=2.0

# Дайджест
DEFAULT_DIGEST_INTERVAL_HOURS=4
POSTS_PER_CHANNEL=20
MAX_NEWS_IN_DIGEST=10
MAX_POSTS_TO_AI=50
DIGEST_LANGUAGE=ru
DB_PATH=/data/bot_data.db

# Веб-новости — ОТКЛЮЧЕНО (бот работает только с вашими каналами)
INCLUDE_WEB_NEWS=false
WEB_NEWS_TOPIC=главные мировые и российские новости дня
